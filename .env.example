PORT=4000
NODE_ENV=development
DB_TYPE=mysql
DB_PORT=3306

# JWT used by the `authorize` middleware on create / update / delete APIs
JWT_SECRET=change_this_to_a_long_random_string
JWT_TOKEN_EXPIRE_PERIOD=30d

# Comma separated list of allowed frontend origins (empty = allow all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# true = TypeORM creates/updates the tables from the entities (use for first run / dev only)
DB_SYNCHRONIZE=true

MAX_CONNECTION_LIMIT=5
IDLE_TIMEOUT_IN_MILI_SEC=30000
DB_CONNECT_TIMEOUT=60000

# Database is picked by the hostname the API is called on (same pattern as the other projects).
# For local dev the hostname is "localhost"; in production use the API domain, e.g. api.example.com
EVENTS_DOMAIN=localhost
EVENTS_DB_HOST=127.0.0.1
EVENTS_DB_USER_NAME=root
EVENTS_DB_PASSWORD=change_me
EVENTS_DB_DATABASE_NAME=events_db

# Console logging is always on. Set true to also write rotating log files (not on hosted platforms)
LOG_TO_FILE=false
